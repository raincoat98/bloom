# 운영 배포용 변수. 복사한 뒤 비어 있는 값을 반드시 채우세요.
#   cp .env.prod.example .env.prod
#
# 적용: docker compose --env-file .env.prod up -d --build   (또는 make prod-up)
#
# 필수값을 비워 두면 compose 가 즉시 실패합니다. 개발용 기본 시크릿이나 localhost 주소로
# 운영이 뜨는 사고를 막기 위한 의도된 동작입니다.

COMPOSE_PROJECT_NAME=bloom-prod
NODE_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=bloom
POSTGRES_DB=bloom
# openssl rand -hex 24  결과를 넣으세요.
POSTGRES_PASSWORD=

# loopback 에만 열립니다. dev 와 같은 호스트에서 돌린다면 dev 와 다른 포트로 두세요.
DB_PORT=5432

# 관리형 Postgres 를 쓴다면 true 로 바꾸고 DATABASE_URL 을 지정하세요.
# (DATABASE_URL 을 지정하면 PG* 변수 대신 이것이 사용됩니다.)
DATABASE_SSL=false
# DATABASE_URL=postgres://user:password@host:5432/bloom

# ── 애플리케이션 ──────────────────────────────────────────────────
# dev 와 반드시 다른 값. openssl rand -hex 32
JWT_SECRET=

# 역프록시가 붙을 호스트 포트
BACKEND_PORT=3000
FRONTEND_PORT=5173
# 프론트/백엔드/DB 바인딩 주소. 역프록시 뒤에 두려면 loopback 유지.
# BIND_HOST=127.0.0.1

# 프론트엔드(nginx)만 노출할 바인딩 주소. 터널(cloudflared)이 VM/컨테이너 안에서 돌면
# 인그레스가 호스트 LAN IP 로 들어오므로 0.0.0.0 이 필요합니다. DB/백엔드는 BIND_HOST 로만.
PUBLIC_BIND_HOST=127.0.0.1

# 예: https://api.example.com
# localhost 를 넣으면 배포된 사용자 브라우저가 자기 pc 를 호출합니다.
VITE_API_URL=

# 예: https://example.com
FRONTEND_URL=

# ── 백업 ─────────────────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=30