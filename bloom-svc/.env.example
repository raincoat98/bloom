# Bloom 백엔드 환경변수 예시 (복사해서 .env 로 사용)
# cp .env.example .env
#
# compose 로 띄울 때는 이 파일이 아니라 루트의 .env.dev / .env.prod 를 사용합니다.
# 이 파일은 `npm run start:dev` 처럼 백엔드를 호스트에서 직접 실행할 때 씁니다.
PORT=3000
# 운영 배포 시 반드시 긴 랜덤 문자열로 교체하세요
JWT_SECRET=로컬-테스트용-시크릿-교체필요
# 프론트엔드 주소 (CORS 허용). 쉼표로 여러 개 가능
FRONTEND_URL=http://localhost:5173

# ── Postgres 접속 ────────────────────────────────────────────────
# DATABASE_URL 이 있으면 최우선으로 사용합니다. 없으면 아래 PG* 변수를 씁니다.
# 아래 값은 .env.dev 의 POSTGRES_USER / POSTGRES_PASSWORD / DB_PORT 와 맞춰야 합니다.
DATABASE_URL=postgres://bloom:dev-password@localhost:5432/bloom
# DATABASE_URL 없이 개별 지정도 가능 (libpq 표준)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=bloom
# PGPASSWORD=dev-password
# PGDATABASE=bloom

# 관리형 Postgres 가 TLS 를 요구하면 true
# DATABASE_SSL=false
# 커넥션 풀 크기 (기본 10)
# PG_POOL_MAX=10

# SQLite → Postgres 이관 시 원본 파일 경로 (npm run migrate:from-sqlite)
# SQLITE_PATH=data/bloom.db