# 로컬/개발 환경 배포용 변수. 복사해서 사용하세요.
#   cp .env.dev.example .env.dev
#
# 적용: docker compose --env-file .env.dev up -d --build

# 프로젝트 이름이 다르면 컨테이너·볼륨·이미지가 모두 분리됩니다 (dev/prod 동시 실행 가능).
COMPOSE_PROJECT_NAME=bloom-dev
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=bloom
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=bloom
# 호스트에 노출할 포트 (loopback). 개발 pc 에 다른 Postgres 가 있으면 바꾸세요.
DB_PORT=5432
# 관리형 Postgres 를 쓰면 true, 그리고 DATABASE_URL 을 지정하세요.
DATABASE_SSL=false
# DATABASE_URL=postgres://user:password@host:5432/bloom

# ── 애플리케이션 ──────────────────────────────────────────────────
# dev 전용 값입니다. 운영 시크릿을 여기에 쓰지 마세요.
JWT_SECRET=dev-only-secret-change-me

# 호스트에 노출할 포트
BACKEND_PORT=3000
FRONTEND_PORT=5173
# 프론트/백엔드/DB 바인딩 주소. 역프록시 뒤에 두려면 loopback 유지.
# BIND_HOST=127.0.0.1

# 프론트엔드(nginx)만 노출할 바인딩 주소. 터널(cloudflared)이 VM/컨테이너 안에서 돌면
# 인그레스가 호스트 LAN IP 로 들어오므로 0.0.0.0 이 필요합니다. DB/백엔드는 BIND_HOST 로만.
PUBLIC_BIND_HOST=127.0.0.1

# 브라우저가 호출할 API 주소 (프론트엔드 빌드 시 번들에 포함됨)
VITE_API_URL=http://localhost:3000
# 백엔드 CORS 허용 주소
FRONTEND_URL=http://localhost:5173

# ── 백업 ─────────────────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14